APP_NAME="AksyRes"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-stitch-web-service.onrender.com
APP_KEY=base64:generate-this-locally

# Google OAuth web client. Register this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=containers-us-west-123.railway.app
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=replace-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Server-enforced manual severity; this takes precedence over AI_TEXT_ENABLED.
AI_TEXT_MODE=MANUAL_ONLY
AI_TEXT_ENABLED=false
AI_TEXT_SERVICE_URL=https://stitch-ai-demo.onrender.com
AI_TEXT_TIMEOUT=10
AI_TEXT_CONNECT_TIMEOUT=3
AI_TEXT_ALLOW_EXPERIMENTAL=false

LORA_INGEST_TOKEN=replace-me-shared-lora-token

ROUTING_SERVICE_ENABLED=true
ROUTING_SERVICE_URL=https://router.project-osrm.org
ROUTING_SERVICE_PROFILE=driving
ROUTING_SERVICE_TIMEOUT=8
ROUTING_SERVICE_CACHE_TTL_MINUTES=10
ROUTING_SERVICE_PROVIDER="OSRM Public Routing"

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=auto
AWS_BUCKET=replace-me
AWS_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=stitch-reverb-app
REVERB_APP_KEY=replace-me
REVERB_APP_SECRET=replace-me
REVERB_HOST=your-stitch-web-service.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Civilian reporting requires a deployed face-enabled worker.
FACE_LIVENESS_SERVICE_URL=https://your-face-check-service.onrender.com
