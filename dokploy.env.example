# Copy these into the Docker Compose environment settings in Dokploy.
# Generate APP_KEY with: cd web_system && php artisan key:generate --show
APP_NAME=Tomas Oppus Rescue
APP_KEY=base64:replace-with-generated-laravel-key
APP_URL=https://rescue.example.com
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret

# Use strong, unique values. Do not commit the real values.
DB_DATABASE=rescue
DB_USERNAME=rescue_app
DB_PASSWORD=replace-with-long-random-password
DB_ROOT_PASSWORD=replace-with-different-long-random-password
LORA_INGEST_TOKEN=replace-with-long-random-token

# Reverb is served through the same public HTTPS domain on /app and /apps.
REVERB_APP_ID=tomas-oppus-rescue
REVERB_APP_KEY=replace-with-random-key
REVERB_APP_SECRET=replace-with-random-secret
REVERB_HOST=rescue.example.com

# Explicit experimental text pilot; all operational severities require admin confirmation.
# Roll back by setting MANUAL_ONLY and false, then redeploy without deleting volumes.
AI_TEXT_MODE=MODEL_ADVISORY
AI_TEXT_ENABLED=true

# The app starts with email logged locally. Configure real SMTP before relying
# on password reset or verification email delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Tomas Oppus Rescue
